# 이 파일을 .env 로 복사한 뒤 값을 채우세요:  cp .env.example .env
# (.env 는 .gitignore 에 들어 있어 커밋되지 않습니다)

# ---- STT: openai | local | mock
#   openai : OpenAI Whisper API (OPENAI_API_KEY 필요)
#   local  : faster-whisper 로컬 실행 (pip install -r backend/requirements-local.txt)
#   mock   : 키 없이 화면 확인용 가짜 인식기
STT_PROVIDER=openai
OPENAI_STT_MODEL=whisper-1
# OPENAI_STT_MODEL=gpt-4o-transcribe
LOCAL_WHISPER_MODEL=small
# cpu(기본) / cuda (CUDA 12 + cuBLAS/cuDNN 설치된 NVIDIA GPU 에서만)
LOCAL_WHISPER_DEVICE=cpu

# ---- LLM(문맥 보정 · 상담사): anthropic | openai | ollama | mock
#   ollama : PC에서 도는 무료 LLM (winget install Ollama.Ollama → ollama pull exaone3.5:7.8b)
LLM_PROVIDER=anthropic
# 비워 두면 기본값: anthropic → claude-sonnet-5-5, openai → gpt-4o-mini, ollama → exaone3.5:7.8b
# OLLAMA_BASE_URL=http://127.0.0.1:11434/v1
LLM_MODEL=

# ---- API 키 (선택한 공급자에 필요한 것만)
OPENAI_API_KEY=
ANTHROPIC_API_KEY=

# ---- 경로 (보통 바꿀 필요 없음, 비우면 프로젝트 기본 폴더)
# DATA_DIR=./data
# SAMPLES_DIR=./samples
# STORAGE_DIR=./storage
# DB_PATH=./storage/poc.db
# CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# ---- 외부 공유(share.bat) 접속 코드. share.bat 실행 때만 쓰이고 start.bat(내 PC 전용)에는 잠금 없음. 비우면 실행할 때마다 무작위 6자리
# SHARE_ACCESS_CODE=123456
